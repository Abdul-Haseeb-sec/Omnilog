# ── OmniLog Configuration ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#
# ⚠️  SECURITY WARNING: This server has NO authentication.
#     It is designed for localhost use ONLY.
#     Do NOT expose port 5000 on any network without adding auth first.
#     Do NOT port-forward this to the internet.

# AbuseIPDB API Key (free tier: 1,000 lookups/day)
# Sign up at https://www.abuseipdb.com/register
# Leave blank to use AlienVault OTX (no key required, lower fidelity)
ABUSEIPDB_API_KEY=

# Server
API_PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limits
MAX_UPLOAD_MB=500
SUBPROCESS_TIMEOUT=120
